# n8n — configure at least one of: HTTP API base (VITE_N8N_URL) and/or webhook URL(s).
#
# Base URL for REST-style integration: the app POSTs the same JSON body to:
#   {VITE_N8N_URL}/form/{form_id}
# form_id is built from passport + date (e.g. 201381722_2026-08-01), or "unscoped" if missing.
# (Browser bundles require the VITE_ prefix; this is the env counterpart to a literal N8N_URL.)
# VITE_N8N_URL=https://your-n8n.example.com

# Webhook URL(s) (copy from n8n Webhook node, Production URL)
VITE_N8N_WEBHOOK_URL=

# Optional: separate workflows for draft vs final submit (otherwise VITE_N8N_WEBHOOK_URL is used for both)
# VITE_N8N_DRAFT_WEBHOOK_URL=
# VITE_N8N_SUBMIT_WEBHOOK_URL=

# Optional: extra header on webhook requests (values are exposed in the client bundle)
# VITE_N8N_WEBHOOK_HEADER_NAME=
# VITE_N8N_WEBHOOK_HEADER_VALUE=

# --- Vercel Blob (cloud JSON backups + landing list) ---
# JSON files use prefix forms/ and readable names, e.g. forms/shimi_berko_1234455_2026-05-09.json
# Link your Blob store (e.g. js-visa-blob) to this project in the Vercel dashboard.
# Vercel usually injects this automatically; required for POST/GET /api/form-blob.
# BLOB_READ_WRITE_TOKEN=
#
# For local API routes + Blob: run `vercel dev` (plain `vite` has no /api).
#
# Delete from landing ("מחק"): POST /api/delete-form removes the JSON blob and S3 keys listed in that blob (same BLOB_READ_WRITE_TOKEN + AWS_* as uploads).

# --- S3 uploads (optional) ---
# Production: set in Vercel → Settings → Environment Variables for Production (and Preview if needed).
# Never use VITE_* for secrets. Redeploy after changing env — old deployments keep old values.
#
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
#
# Bucket name (either key works):
# S3_BUCKET=js_visa
# S3_BUCKET_NAME=js_visa
#
# Region: prefer S3_REGION for the bucket. Vercel pre-injects AWS_REGION as the *deployment* region
# (see https://vercel.com/kb/guide/how-can-i-use-aws-sdk-environment-variables-on-vercel ) unless you
# override AWS_REGION in project env per environment — wrong region → SignatureDoesNotMatch.
# S3_REGION=eu-north-1
# AWS_REGION=eu-north-1
#
# Optional: DEBUG_UPLOAD=1 enables GET /api/upload (same origin) to return non-secret config (region/bucket flags).
# First POST /api/upload per cold start logs one sanitized aws env line in Runtime Logs; secrets are never printed.

# Dev only: full URL to upload API if not using `vercel dev`
# VITE_S3_UPLOAD_API_URL=http://localhost:3000/api/upload

# --- OpenAI (server only: passport OCR + form translation; never VITE_*) ---
# Required for POST /api/extract-passport and POST /api/translate-form
# OPENAI_API_KEY=

# --- Browser Use Cloud (server only: I-94 travel history automation) ---
# Required for POST /api/browser-use — same as n8n-style env: process.env.BROWSER_USE_API_KEY
# BROWSER_USE_API_KEY=

# --- Monday.com (server only: POST /api/monday — "שלח ל-Monday" in translation modal) ---
# Create a board API token with boards:write (and updates:write if you use optional metadata → item update).
# MONDAY_FILE_COLUMN_ID = the Files column id from the board (not the title).
# MONDAY_API_TOKEN=
# MONDAY_BOARD_ID=
# MONDAY_FILE_COLUMN_ID=
#
# Local Vite has no /api routes unless you run `vercel dev`; then set in .env.local:
# VITE_MONDAY_API_URL=http://localhost:3000/api/monday
