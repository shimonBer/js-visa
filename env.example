# n8n — at least one webhook URL (copy from n8n Webhook node, Production URL)
VITE_N8N_WEBHOOK_URL=

# Optional: separate workflows for draft vs final submit (otherwise VITE_N8N_WEBHOOK_URL is used for both)
# VITE_N8N_DRAFT_WEBHOOK_URL=
# VITE_N8N_SUBMIT_WEBHOOK_URL=

# Optional: extra header on webhook requests (values are exposed in the client bundle)
# VITE_N8N_WEBHOOK_HEADER_NAME=
# VITE_N8N_WEBHOOK_HEADER_VALUE=

# --- S3 uploads (optional) ---
# Production: set AWS vars in Vercel (Settings → Environment Variables). Do NOT prefix with VITE_.
# The app calls same-origin POST /api/presign (serverless); keys never ship to the browser.
#
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-west-1
# S3_BUCKET=js_visa
# Optional for temporary credentials:
# AWS_SESSION_TOKEN=

# Dev only: point the SPA at a running presign API if not using `vercel dev`
# VITE_S3_PRESIGN_API_URL=http://localhost:3000/api/presign
